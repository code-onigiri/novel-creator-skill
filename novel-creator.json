{
  "id": "novel-claude-ai",
  "name": "Novel Claude AI - Novel Creation Master",
  "description": "Full-lifecycle Chinese novel creation skill. Use when the user wants to write a novel, create a story, continue a chapter, brainstorm a plot, build a worldbuilding, design character relationships, extract writing style, or imitate another novel. Covers the complete chain from a vague idea to a 3-million-character finished work.",
  "version": "1.0.0",
  "activation": {
    "patterns": [
      "/novel-analyze",
      "/novel-create",
      "/one-click-start",
      "/imitate",
      "/fix-chapter",
      "/continue-write",
      "/beginner-mode",
      "/foreshadow-status",
      "/edit-chapter",
      "/write",
      "/write-full",
      "/full-flow",
      "/init-db",
      "/batch-write",
      "/disassemble",
      "/timeline",
      "/update-memory",
      "/copyedit",
      "/check-consistency",
      "/update-plot-index",
      "/plot-retrieve",
      "/memory-retrieve",
      "/resume",
      "/character-status",
      "/gate-check",
      "/genre-style",
      "/style-search",
      "/style-extract",
      "/style-calibrate",
      "/style-transfer",
      "/benchmark",
      "/online-research",
      "/auto-write",
      "/brainstorm-map",
      "/revise-outline",
      "/dual-review",
      "novel creation",
      "disassemble a novel",
      "plot retrieval",
      "million-word novel",
      "vague plot idea",
      "imitate",
      "generate an outline",
      "worldbuilding",
      "write a novel",
      "write a story",
      "continue writing",
      "write a chapter",
      "brainstorm a plot",
      "character relationships",
      "writing style",
      "help me write a story",
      "idea for a novel",
      "story outline",
      "knowledge graph",
      "brainstorm"
    ],
    "triggers": [
      "User wants the simplest onboarding flow",
      "User has only a vague plot idea or a single inspiration",
      "User provides a sample chapter and requests style imitation",
      "User wants to imitate or disassemble a novel",
      "User needs to create, continue, or batch-write a novel",
      "User needs to modify a chapter or update memory",
      "User needs to check consistency or calibrate style",
      "User needs fix steps after a gate failure",
      "User needs pre-writing automatic matching of relevant chapter context",
      "User needs to evaluate process performance",
      "User wants to build a worldbuilding or design character relationships",
      "User wants to modify the plot outline mid-stream",
      "User wants to fully automatically write a book",
      "User wants to extract or switch writing style"
    ]
  },
  "capability_matrix": {
    "implemented": [
      "Beginner Three Commands",
      "Five-Step Quality Gate",
      "RAG Plot Retrieval",
      "Online Research",
      "Style Extraction and Reuse",
      "Baseline Evaluation"
    ],
    "partial": [
      "Full-Auto Novel Writing",
      "Novel Imitation"
    ],
    "planned": [
      "Interactive Brainstorming",
      "Knowledge Graph",
      "Outline Anchors",
      "Multi-Step Pipeline",
      "Anti-Resolution Brake",
      "Event Cooldown",
      "Cross-Agent Review",
      "Mid-Stream Outline Change Cascading"
    ]
  },
  "memory_system": {
    "principle": "Context window = memory (volatile); File system = disk (persistent)",
    "smart_state": {
      "mandatory_reads": [
        "00_memory/novel_plan.md",
        "00_memory/novel_state.md"
      ],
      "max_files_per_chapter": 4
    },
    "plot_retrieval": {
      "script": "scripts/plot_rag_retriever.py",
      "index_file": "00_memory/retrieval/story_index.json",
      "context_file": "00_memory/retrieval/next_plot_context.md"
    },
    "story_graph": {
      "file": "00_memory/story_graph.json",
      "schema": "references/story-graph-schema.md",
      "status": "planned"
    },
    "gate_artifacts": {
      "path": "04_editing/gate_artifacts/<chapter_id>/",
      "required_files": [
        "memory_update.md",
        "consistency_report.md",
        "style_calibration.md",
        "copyedit_report.md",
        "publish_ready.md",
        "gate_result.json"
      ],
      "verification_script": "scripts/chapter_gate_check.py"
    },
    "chapter_storage_policy": {
      "chapter_dir": "03_manuscript/",
      "rule": "Chapters must be saved to 03_manuscript/*.md; mixing into 02_knowledge_base/ is prohibited"
    }
  },
  "executor": {
    "script": "scripts/novel_flow_executor.py",
    "one_click": "python3 scripts/novel_flow_executor.py one-click --project-root <project directory> --title <book title> --genre <genre> --idea <plot seed>",
    "continue_write": "python3 scripts/novel_flow_executor.py continue-write --project-root <project directory> --query \"<new plot>\""
  },
  "workflow": {
    "beginner_quickstart": [
      "/一键开书",
      "/继续写",
      "/修复本章"
    ],
    "chapter_pipeline": [
      "/剧情检索",
      "/写作",
      "/更新记忆",
      "/检查一致性",
      "/风格校准",
      "/校稿",
      "/门禁检查",
      "/更新剧情索引"
    ],
    "planned_pipeline": [
      "Anchor Quota Check",
      "Beat Sheet Generation",
      "Beat Expansion",
      "Chapter Synthesis",
      "Gate Check",
      "Graph Writeback",
      "Cross-Agent Review"
    ]
  },
  "compatibility": {
    "supported_tools": [
      "codex",
      "claude-code",
      "opencode",
      "gemini-cli",
      "antigravity"
    ],
    "installer": "scripts/install-portable-skill.sh"
  }
}
